# ============================================================
# Tessa environment configuration
# Copy to .env and fill in. .env is gitignored — never commit it.
# ============================================================

# ---- Core ----
TESSA_ENV=development            # development | production
TESSA_DOMAIN=tessa.ki-c.pro
PUBLIC_BASE_URL=https://tessa.ki-c.pro

# ---- Security ----
# Generate strong values: `openssl rand -hex 32`
SECRET_KEY=change_me_session_signing_key
# Fernet key for encrypting provider API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change_me_fernet_key
SESSION_TTL_MINUTES=720
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- PostgreSQL ----
POSTGRES_DB=tessa
POSTGRES_USER=tessa
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333

# ---- LiteLLM gateway ----
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-tessa-master-change_me

# ---- Model provider keys (optional; can also be set via Admin UI) ----
# Leave blank to use the built-in mock provider for local dev.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ---- Embeddings ----
EMBEDDING_PROVIDER=mock           # mock | openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Bootstrap superadmin (used once by seed script) ----
BOOTSTRAP_ADMIN_USERNAME=kai
BOOTSTRAP_ADMIN_DISPLAY_NAME=Kai
BOOTSTRAP_ADMIN_PASSWORD=change_me_initial_password

# ---- Web ----
PUBLIC_API_BASE=/api

# ---- Workspace ----
DEFAULT_WORKSPACE=company-default

# ---- External model nodes (optional; Ollama / vLLM, NOT on this host) ----
MODEL_NODE_1_URL=http://model-node-1.internal:11434
MODEL_NODE_2_URL=http://model-node-2.internal:8000

# ---- Backups ----
BACKUP_PASSPHRASE=change_me_backup_passphrase
